<section id="systems" class="wrap" aria-labelledby="systems-h">
  <div class="systems">
    <div>
      <h2 class="h2" id="systems-h">What I work on</h2>
      <p class="lede">Dealer photos, phone calls and text messages all enter the same event backbone. From there, one path turns images into studio-quality listings for 100+ enterprises; the other feeds Vini, an LLM agent that talks to customers and updates the dealer's CRM.</p>
      <div class="chips">
        <div class="chip"><b>66%</b><span>faster image processing</span></div>
        <div class="chip"><b>~1M</b><span>images processed concurrently</span></div>
        <div class="chip"><b>&lt;1%</b><span>pipeline failure rate</span></div>
      </div>
    </div>
    <figure class="pipe" aria-label="Animated diagram of the systems I work on: dealer photos, calls and SMS enter a Kafka event stream. In the media lane an orchestrator feeds AWS Step Functions, which produces studio images for 100+ enterprises. In the conversation lane Vini, an LLM agent, works with the dealer's inventory and CRM and sends follow-up SMS. Events are stored in ClickHouse for analytics and audit.">
      <div class="pipe-head"><span>Data flow</span><span class="live">running</span></div>
      <svg viewBox="0 0 624 378" aria-hidden="true">
        <rect class="lane" x="162" y="14" width="458" height="140" rx="12"/><text class="lane-l" x="174" y="34">MEDIA PIPELINE</text>
        <rect class="lane" x="162" y="164" width="458" height="162" rx="12"/><text class="lane-l" x="174" y="181">CONVERSATIONS</text>
        <g>
          <path class="wire" id="r1" d="M96 80 H562"/>
          <path class="wire" id="r2" d="M96 212 H470"/>
          <path class="wire" id="r3" d="M96 290 H130 V212 H220 V290 H385"/>
          <path class="wire dash" d="M146 354 H172"/>
        </g>
        <g id="packets"></g>
        <g class="node"><rect x="0" y="58" width="96" height="44" rx="9"/><text x="48" y="77" text-anchor="middle">Dealer photos</text><text class="s" x="48" y="92" text-anchor="middle">images, video</text></g>
        <g class="node"><rect x="0" y="190" width="96" height="44" rx="9"/><text x="48" y="209" text-anchor="middle">Voice calls</text><text class="s" x="48" y="224" text-anchor="middle">LiveKit</text></g>
        <g class="node"><rect x="0" y="268" width="96" height="44" rx="9"/><text x="48" y="287" text-anchor="middle">SMS</text><text class="s" x="48" y="302" text-anchor="middle">Twilio</text></g>
        <g class="node"><rect x="172" y="58" width="96" height="44" rx="9"/><text x="220" y="77" text-anchor="middle">Orchestrator</text><text class="s" x="220" y="92" text-anchor="middle">per media type</text></g>
        <g class="node core"><rect x="330" y="54" width="110" height="52" rx="9"/><text x="385" y="77" text-anchor="middle">Step Functions</text><text class="s" x="385" y="92" text-anchor="middle">image pipeline</text></g>
        <g class="node"><rect x="514" y="58" width="96" height="44" rx="9"/><text x="562" y="77" text-anchor="middle">Studio images</text><text class="s" x="562" y="92" text-anchor="middle">100+ enterprises</text></g>
        <g class="node ai"><rect x="172" y="186" width="96" height="52" rx="9"/><text x="220" y="209" text-anchor="middle">Vini</text><text class="s" x="220" y="224" text-anchor="middle">LLM agent</text></g>
        <g class="node"><rect x="330" y="190" width="280" height="44" rx="9"/><text x="470" y="209" text-anchor="middle">Dealer inventory &amp; CRM</text><text class="s" x="470" y="224" text-anchor="middle">live inventory, leads, appointments</text></g>
        <g class="node"><rect x="330" y="268" width="110" height="44" rx="9"/><text x="385" y="287" text-anchor="middle">Follow-up SMS</text><text class="s" x="385" y="302" text-anchor="middle">via Twilio</text></g>
        <g class="node core bus"><rect x="114" y="14" width="32" height="356" rx="9"/><text x="130" y="196" text-anchor="middle" transform="rotate(-90 130 192)">Kafka event stream</text></g>
        <g class="node"><rect x="172" y="338" width="438" height="32" rx="9"/><text x="391" y="358" text-anchor="middle">ClickHouse <tspan class="s">· analytics &amp; audit</tspan></text></g>
      </svg>
    </figure>
  </div>
</section>

<script>
  // Pipeline packets travelling along the wires.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const svgNS = 'http://www.w3.org/2000/svg';
  const g = document.getElementById('packets')!;
  type Route = { p: SVGPathElement; c: string; every: number; len: number; last: number };
  const routes: Route[] = [
    ['r1', 'var(--accent)', 900],
    ['r2', 'var(--amber)', 1700],
    ['r3', 'var(--amber)', 2300],
  ].map(([id, c, every]) => {
    const p = document.getElementById(id as string) as unknown as SVGPathElement;
    return { p, c: c as string, every: every as number, len: p.getTotalLength(), last: -99999 };
  });

  const dot = (r: Route) => {
    const c = document.createElementNS(svgNS, 'circle');
    c.setAttribute('r', '4.5');
    c.style.fill = r.c;
    g.appendChild(c);
    return c;
  };

  if (reduce) {
    routes.forEach((r) => [0.2, 0.5, 0.8].forEach((f) => {
      const pt = r.p.getPointAtLength(r.len * f);
      const c = dot(r);
      c.setAttribute('cx', String(pt.x));
      c.setAttribute('cy', String(pt.y));
    }));
  } else {
    let visible = true;
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(document.querySelector('.pipe')!);
    const packets: { el: SVGCircleElement; r: Route; t: number }[] = [];
    let prev = performance.now();
    const tick = (now: number) => {
      const dt = now - prev;
      prev = now;
      if (visible && dt < 200) {
        routes.forEach((r) => { if (now - r.last > r.every) { r.last = now; packets.push({ el: dot(r), r, t: 0 }); } });
        for (let i = packets.length - 1; i >= 0; i--) {
          const k = packets[i];
          k.t += dt / 3200;
          if (k.t >= 1) { k.el.remove(); packets.splice(i, 1); continue; }
          const pt = k.r.p.getPointAtLength(k.r.len * k.t);
          k.el.setAttribute('cx', String(pt.x));
          k.el.setAttribute('cy', String(pt.y));
          k.el.style.opacity = String(k.t > 0.9 ? (1 - k.t) * 10 : 1);
        }
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
