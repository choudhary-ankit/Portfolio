---
// Every fact here also appears elsewhere on the page (Impact, Journey, Work). Keep them in sync.
const qa = [
  ['What are you working on right now?', "I'm building Vini at Spyne: an LLM agent that answers car-dealership sales and service calls and texts, with live access to the dealer's inventory and CRM. Most recently I designed its automated SMS follow-up for calls that end without an outcome, using eligibility gates, a debounced EventBridge schedule and a Kafka to ClickHouse audit trail."],
  ["What's your biggest technical win?", 'Rebuilding our AI image-processing pipeline on AWS Step Functions. Large batches went from 90 minutes to 30 (66% faster), with around a million images processed concurrently for 100+ enterprise clients. Alongside it, better monitoring and retries brought the pipeline failure rate from 7% to under 1%.'],
  ['What kind of role are you looking for?', 'Backend, distributed systems or applied AI (LLM) roles where I own services end to end, from design through running them in production. I do my best work on problems where scale and reliability matter: event-driven systems, media pipelines and agents that have to hold up under real load.'],
  ['Have you led a team?', "Yes. At Acadza I built and led a team of six engineers while shipping the company's first production platform from scratch. I mentored them on delivery, debugging and scalable frontend practices, and created the internal Next.js / Redux framework the team built on."],
  ['Why did you switch from mechanical engineering?', 'I studied mechanical engineering (B.Tech, 2014 to 2018), taught myself to code, and joined Acadza as a software engineer in 2021. The engineering mindset came with me: I still think in terms of throughput, failure modes and what happens under load, just in distributed systems instead of machines.'],
];
---
<section id="ask" class="wrap" aria-labelledby="ask-h">
  <h2 class="h2" id="ask-h">Quick answers</h2>
  <p class="lede">Short on time? Pick a question.</p>
  <div class="ask">
    <div class="qs">
      {qa.map(([q], i) => <button class="q" type="button" data-a={i} aria-pressed="false">{q}</button>)}
    </div>
    <div class="chat" id="chat" aria-live="polite"><p class="hint">Pick a question on the left to see my answer here.</p></div>
  </div>
  <!-- Answers ship in the HTML (readable without JS and by crawlers); the script moves them into the chat. -->
  <dl class="sr-only" id="answers">
    {qa.map(([q, a]) => <><dt>{q}</dt><dd>{a}</dd></>)}
  </dl>
</section>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const chat = document.getElementById('chat')!;
  const answers = [...document.querySelectorAll('#answers dd')].map((d) => d.textContent || '');
  const qs = [...document.querySelectorAll<HTMLButtonElement>('.q')];
  let busy = false;
  const bubble = (cls: string) => {
    const d = document.createElement('div');
    d.className = 'msg ' + cls;
    chat.appendChild(d);
    return d;
  };
  qs.forEach((q) => q.addEventListener('click', () => {
    if (busy) return;
    busy = true;
    qs.forEach((x) => x.setAttribute('aria-pressed', String(x === q)));
    chat.innerHTML = '';
    bubble('you').textContent = q.textContent;
    const t = bubble('me');
    t.innerHTML = '<span class="typing"><i></i><i></i><i></i></span>';
    setTimeout(() => { t.textContent = answers[Number(q.dataset.a)]; busy = false; }, reduce ? 0 : 650);
  }));
</script>
