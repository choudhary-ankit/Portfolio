---
import '../styles/global.css';
import { PROFILE, SEO, SITE_URL } from '../config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  preloadPhoto?: boolean;
}

const {
  title = SEO.title,
  description = SEO.description,
  noindex = false,
  preloadPhoto = false,
} = Astro.props;

const FONTS =
  'https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap';
const canonical =new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL('/og-image.png', SITE_URL).href;
const photo = new URL('/photo.jpg', SITE_URL).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE_URL}/#person`,
    name: PROFILE.name,
    jobTitle: PROFILE.jobTitle,
    worksFor: { '@type': 'Organization', name: PROFILE.employer },
    address: {
      '@type': 'PostalAddress',
      addressLocality: PROFILE.locality,
      addressRegion: PROFILE.region,
      addressCountry: PROFILE.country,
    },
    email: `mailto:${PROFILE.email}`,
    url: `${SITE_URL}/`,
    image: photo,
    sameAs: [PROFILE.linkedin, PROFILE.github],
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Swami Vivekanand Institute of Engineering & Technology' },
    knowsLanguage: ['English', 'Hindi'],
    knowsAbout: [
      'Distributed systems',
      'Event-driven architecture',
      'Microservices',
      'System design',
      'LLM applications',
      'Conversational AI',
      'Node.js',
      'JavaScript',
      'Python',
      'Kafka',
      'AWS Step Functions',
      'Redis',
      'MongoDB',
      'ClickHouse',
      'React.js',
      'Next.js',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: PROFILE.name,
    url: `${SITE_URL}/`,
    inLanguage: 'en',
    author: { '@id': `${SITE_URL}/#person` },
  },
];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={PROFILE.name} />
    <meta name="theme-color" content={SEO.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={PROFILE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ankit Choudhary, Software Engineer II at Spyne" />
    <meta property="profile:first_name" content="Ankit" />
    <meta property="profile:last_name" content="Choudhary" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {preloadPhoto && <link rel="preload" as="image" href="/photo.jpg" fetchpriority="high" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Loaded without blocking first paint; display=swap shows fallback text until the fonts arrive. -->
    <link rel="preload" as="style" href={FONTS} />
    <link rel="stylesheet" href={FONTS} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={FONTS} /></noscript>

    <!-- Dark by default; light only if the visitor chose it. Runs before paint to avoid a flash. -->
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <script>
      // Smooth in-page links (also works inside embedded viewers).
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest('a[href^="#"]');
        if (!a) return;
        const id = a.getAttribute('href')!;
        const t = id === '#top' ? document.body : document.querySelector(id);
        if (!t) return;
        e.preventDefault();
        t.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      });

      // mailto: does nothing when the visitor has no mail app set up (common with webmail),
      // so every email link also copies the address and says so.
      const toast = document.getElementById('toast')!;
      let hide: number | undefined;
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="mailto:"]');
        if (!a) return;
        const email = a.href.slice('mailto:'.length).split('?')[0];
        const show = (msg: string) => {
          toast.textContent = msg;
          toast.classList.add('on');
          clearTimeout(hide);
          hide = window.setTimeout(() => toast.classList.remove('on'), 4000);
        };
        navigator.clipboard?.writeText(email).then(
          () => show(`Email copied: ${email}`),
          () => show(`Email: ${email}`),
        ) ?? show(`Email: ${email}`);
      });
    </script>
    <div id="toast" class="toast" role="status" aria-live="polite"></div>
  </body>
</html>
